// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Size {
  SMALL
  MEDIUM
  LARGER
}

enum EnergyLevel {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum IndependenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum Environment {
  SMALL
  MEDIUM
  LARGER
}

model Org {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String
  cep           String
  address       String
  city          String
  phone         String
  password_hash String
  created_at    DateTime @default(now())

  pets Pet[]

  @@map("orgs")
}

model Pet {
  id                   String            @id @default(uuid())
  name                 String
  description          String
  age                  Int
  size                 Size              @default(MEDIUM)
  energy_level         EnergyLevel       @default(MEDIUM)
  independence_level   IndependenceLevel @default(MEDIUM)
  environment          Environment       @default(MEDIUM)
  image                String
  adoption_requirement String[]
  created_at           DateTime          @default(now())

  org    Org    @relation(fields: [org_id], references: [id])
  org_id String

  @@map("pets")
}
